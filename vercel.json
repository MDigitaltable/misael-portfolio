{
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about/index.dc.html"
    },
    {
      "source": "/work",
      "destination": "/work/index.dc.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.dc.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug.dc.html"
    },
    {
      "source": "/work/:slug",
      "destination": "/work/:slug.dc.html"
    }
  ]
}